{
  "name": "job-agents",
  "version": "0.1.0",
  "description": "Job application pipeline: Scout finds and scores postings, Tailor writes a grounded CV and cover letter, Submitter fills and submits approved applications",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scout": "tsx src/cli.ts",
    "tailor": "tsx src/tailor/cli.ts",
    "submit": "tsx src/submit/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "graph": "langgraphjs dev --host 127.0.0.1",
    "graph:tunnel": "langgraphjs dev --tunnel",
    "review": "tsx src/review/server.ts",
    "schedule": "tsx src/schedule.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@langchain/core": "1.2.16",
    "@langchain/langgraph": "1.4.21",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "html-to-text": "10.0.1",
    "imapflow": "2.1.2",
    "mailparser": "3.9.32",
    "mammoth": "1.13.0",
    "node-cron": "4.6.0",
    "playwright-core": "1.63.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.5.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
