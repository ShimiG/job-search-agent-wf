# Required for scoring (run --no-score works without it)
ANTHROPIC_API_KEY=

# Scoring model. claude-haiku-5-5 is cheaper if you score a lot of postings.
SCOUT_MODEL=claude-sonnet-5-5

# Optional: read job-alert emails (LinkedIn, Drushim...) over IMAP.
# For Gmail, use an app password (needs 2-Step Verification), not your normal password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# debug | info | warn | error
LOG_LEVEL=info

# Tailor agent model (writing + fact-checking). Defaults to claude-sonnet-5-5.
TAILOR_MODEL=claude-sonnet-5-5

# Model that looks up full postings for shortlisted alert-email jobs (web search). Defaults to claude-sonnet-5-5.
# ENRICH_MODEL=claude-sonnet-5-5
