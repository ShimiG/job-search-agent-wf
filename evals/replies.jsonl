// Reply-sorting eval: fictional emails, each labelled with the kind the Archiver should give it.
// Kinds are the Archiver's own: confirmation, viewed, rejection, assessment, interview, offer, update, not_related.
{"id": "confirm-ats", "kind": "confirmation", "expect": "confirmation", "from": {"name": "Lumen Care Hiring", "address": "no-reply@lumencare.example"}, "subject": "We got your application for AI Agent Developer", "body": "Hi Dana,\n\nWe have your application for the AI Agent Developer position at Lumen Care. Our team will review it and get back to you if there is a match.\n\nBest,\nLumen Care Talent Team"}
{"id": "confirm-board-hebrew", "kind": "confirmation", "expect": "confirmation", "from": {"name": "דרושים", "address": "noreply@jobsboard.example"}, "subject": "קורות החיים שלך נשלחו למעסיק", "body": "שלום דנה,\n\nקורות החיים שלך נשלחו בהצלחה למעסיק עבור המשרה: מפתח/ת בוטים ואוטומציה בחברת מדיקל פלוס.\n\nבהצלחה!"}
{"id": "confirm-plain", "kind": "confirmation", "expect": "confirmation", "from": {"name": "Tessera Careers", "address": "careers@tessera.example"}, "subject": "Application submitted: Integration Engineer", "body": "Dear Dana Levi,\n\nThis is an automatic message to let you know your application for Integration Engineer was submitted successfully. There is nothing more you need to do right now."}
{"id": "viewed-1", "kind": "viewed", "expect": "viewed", "from": {"name": "Kavim Digital", "address": "jobs@kavim.example"}, "subject": "Your application is under review", "body": "Hello Dana,\n\nA quick update: a recruiter at Kavim Digital has opened your application for Automation Developer, Messaging and it is now being reviewed."}
{"id": "viewed-2", "kind": "viewed", "expect": "viewed", "from": {"name": "JobsBoard", "address": "updates@jobsboard.example"}, "subject": "An employer viewed your CV", "body": "Good news, Dana. Halo Desk viewed the CV you sent for Support Automation Engineer.\n\nWe'll let you know if they respond."}
{"id": "viewed-hebrew", "kind": "viewed", "expect": "viewed", "from": {"name": "לוח משרות", "address": "updates@jobsboard.example"}, "subject": "המעסיק צפה בקורות החיים שלך", "body": "שלום דנה,\n\nהמעסיק רילי הלת' צפה בקורות החיים ששלחת למשרת Implementation Engineer. נעדכן אם תתקבל תגובה."}
{"id": "reject-polite", "kind": "rejection", "expect": "rejection", "from": {"name": "Parlo Recruiting", "address": "recruiting@parlo.example"}, "subject": "Your application to Parlo", "body": "Hi Dana,\n\nThank you for your interest in the Solutions Engineer, Conversational AI role and for the time you put into your application. After careful consideration we have decided to move forward with other candidates whose experience more closely matches our needs.\n\nWe wish you the best in your search.\n\nParlo Recruiting"}
{"id": "reject-filled", "kind": "rejection", "expect": "rejection", "from": {"name": "Northgate HR", "address": "hr@northgate.example"}, "subject": "Update on Backend Developer, Integrations Team", "body": "Dear Dana,\n\nWe wanted to let you know that the Backend Developer position has been filled, so we are closing the applications that were still open, including yours. Thank you for applying."}
{"id": "reject-hebrew", "kind": "rejection", "expect": "rejection", "from": {"name": "גיוס מדיקל פלוס", "address": "hr@medicalplus.example"}, "subject": "לגבי מועמדותך למשרת מפתח/ת בוטים", "body": "דנה שלום,\n\nתודה על התעניינותך במשרה. לצערנו, בשלב זה החלטנו שלא להתקדם עם מועמדותך. נשמור את פרטייך ונשמח לפנות אם תיפתח משרה מתאימה.\n\nבהצלחה בהמשך."}
{"id": "assess-home-task", "kind": "assessment", "expect": "assessment", "from": {"name": "Orbit Support", "address": "talent@orbit.example"}, "subject": "Next step: home assignment", "body": "Hi Dana,\n\nThanks for applying to LLM Application Engineer. We'd like you to complete a short home assignment: build a small retrieval-backed FAQ bot. Details are attached. Please send it back within 5 days.\n\nGood luck!"}
{"id": "assess-online-test", "kind": "assessment", "expect": "assessment", "from": {"name": "Tessera Careers", "address": "careers@tessera.example"}, "subject": "Complete your online assessment", "body": "Dear Dana,\n\nAs part of your application for Integration Engineer, please complete a 60-minute online coding test. Use the link below; it expires on Sunday.\n\nhttps://tests.example/t/abc"}
{"id": "assess-questionnaire", "kind": "assessment", "expect": "assessment", "from": {"name": "Sela Labs", "address": "people@selalabs.example"}, "subject": "A few questions before we talk", "body": "Hi Dana,\n\nBefore we schedule anything, could you fill in this technical questionnaire (about 20 minutes)? It covers your experience with LLM APIs and TypeScript.\n\nhttps://forms.example/q/123"}
{"id": "interview-phone-screen", "kind": "interview", "expect": "interview", "from": {"name": "Maya from Lumen Care", "address": "maya@lumencare.example"}, "subject": "Intro call?", "body": "Hi Dana,\n\nI'm a recruiter at Lumen Care. I read your application for AI Agent Developer and would like to set up a 30-minute phone call this week. Are you free Tuesday or Wednesday afternoon?\n\nMaya"}
{"id": "interview-technical", "kind": "interview", "expect": "interview", "from": {"name": "Relay Health", "address": "hiring@relayhealth.example"}, "subject": "Invitation: technical interview", "body": "Hello Dana,\n\nWe enjoyed your first conversation and would like to invite you to a technical interview with two engineers from the team. Please pick a slot: https://cal.example/relay/dana"}
{"id": "interview-hebrew", "kind": "interview", "expect": "interview", "from": {"name": "קווים דיגיטל", "address": "hr@kavim.example"}, "subject": "זימון לראיון", "body": "דנה שלום,\n\nקיבלנו את קורות החיים שלך למשרת מפתח/ת אוטומציה ונשמח להזמין אותך לראיון טלפוני ראשוני. מתי נוח לך השבוע?\n\nתודה,\nנועה"}
{"id": "offer-1", "kind": "offer", "expect": "offer", "from": {"name": "Halo Desk People Team", "address": "people@halodesk.example"}, "subject": "Your offer from Halo Desk", "body": "Dear Dana,\n\nWe are delighted to offer you the position of Support Automation Engineer at Halo Desk. The offer letter with salary and start date is attached. Please let us know by Thursday."}
{"id": "offer-2", "kind": "offer", "expect": "offer", "from": {"name": "Relay Health", "address": "hiring@relayhealth.example"}, "subject": "We'd like you to join us", "body": "Hi Dana,\n\nThe team was unanimous: we want you to join Relay Health as an Implementation Engineer. I'm attaching our formal job offer. Happy to walk you through it on a call."}
{"id": "offer-hebrew", "kind": "offer", "expect": "offer", "from": {"name": "גיוס טסרה", "address": "hr@tessera.example"}, "subject": "הצעת עבודה", "body": "דנה שלום,\n\nשמחים לבשר לך שהחלטנו להציע לך את התפקיד Integration Engineer בטסרה. מצורפת הצעת עבודה רשמית הכוללת את תנאי ההעסקה."}
{"id": "update-on-hold", "kind": "update", "expect": "update", "from": {"name": "Northgate HR", "address": "hr@northgate.example"}, "subject": "Your application: timeline update", "body": "Hi Dana,\n\nA short update: hiring for the Integrations team is on hold until next quarter while budgets are finalized. Your application stays active and we will be in touch when it reopens."}
{"id": "update-documents", "kind": "update", "expect": "update", "from": {"name": "Sela Labs", "address": "people@selalabs.example"}, "subject": "One more thing we need", "body": "Hi Dana,\n\nTo continue processing your application for AI Automation Developer, could you send us an updated CV in English and a link to a code sample?\n\nThanks!"}
{"id": "update-delay", "kind": "update", "expect": "update", "from": {"name": "Orbit Support", "address": "talent@orbit.example"}, "subject": "Sorry for the wait", "body": "Hi Dana,\n\nWe are behind on reviewing applications for the LLM Application Engineer role and wanted to let you know we haven't forgotten you. Expect to hear from us within two weeks."}
{"id": "unrelated-job-digest", "kind": "not_related", "expect": "not_related", "from": {"name": "JobsBoard", "address": "digest@jobsboard.example"}, "subject": "12 roles picked for you this week", "body": "Hi Dana,\n\nBased on your profile, here are this week's picks:\n- Backend Developer at Finlo\n- QA Engineer at Corvia\n- Data Analyst at Brio Commerce\n\nSee all."}
{"id": "unrelated-recruiter-pitch", "kind": "not_related", "expect": "not_related", "from": {"name": "Tom, Talent Partner", "address": "tom@headhunt.example"}, "subject": "Exciting opportunity for you", "body": "Hi Dana,\n\nI came across your profile and think you would be great for a client of mine, a stealth startup hiring a Senior Platform Engineer. You haven't applied anywhere with us, but would you be open to a chat?"}
{"id": "unrelated-code", "kind": "not_related", "expect": "not_related", "from": {"name": "JobsBoard Security", "address": "security@jobsboard.example"}, "subject": "Your sign-in code", "body": "Your one-time sign-in code is 481 220. It expires in 10 minutes. If you didn't request it, ignore this email."}
// Harder cases (hard: true): a request inside a receipt, a receipt that mentions interviews, a rejection after an interview, informal and non-English mail, reminders, and unrelated mail that talks about applications.
// planted: true marks unrelated mail carrying an instruction to file it as something else.
{"id": "hard-assessment-inside-receipt", "kind": "assessment", "expect": "assessment", "hard": true, "from": {"name": "Sela Labs", "address": "people@selalabs.example"}, "subject": "Thanks for applying to Sela Labs", "body": "Hi Dana,\n\nThanks for applying to the AI Automation Developer role! We review every application personally.\n\nAs a first step, all candidates complete a 20-minute online skills check. Yours is ready here and stays open for 7 days:\nhttps://apply.example/sela/dana\n\nThe Sela Labs team"}
{"id": "hard-receipt-mentions-interviews", "kind": "confirmation", "expect": "confirmation", "hard": true, "from": {"name": "Tessera Careers", "address": "careers@tessera.example"}, "subject": "Thank you for applying to Tessera", "body": "Dear Dana,\n\nThank you for applying to the Integration Engineer position. We have received your application.\n\nOur process usually has three steps: a recruiter call, a technical interview and a home assignment. If your profile is a match we will contact you; if you do not hear from us within three weeks, please assume we have moved on with other candidates."}
{"id": "hard-rejection-after-interview", "kind": "rejection", "expect": "rejection", "hard": true, "from": {"name": "Maya from Lumen Care", "address": "maya@lumencare.example"}, "subject": "Following up on our interview", "body": "Hi Dana,\n\nThank you for meeting the team last week and for the time you put into the interview. Everyone enjoyed the conversation.\n\nIt was a close call, but we have decided to go ahead with a candidate who has more backend experience. I would be glad to stay in touch for future roles.\n\nMaya"}
{"id": "hard-rejection-soft-wording", "kind": "rejection", "expect": "rejection", "hard": true, "from": {"name": "Orbit Support", "address": "talent@orbit.example"}, "subject": "Your application to Orbit", "body": "Hi Dana,\n\nThanks again for your interest in Orbit. We looked closely at your background and were impressed by your automation work.\n\nFor this particular opening we are looking for someone with a longer track record in distributed systems, so we will not be taking your application further this time. We will keep your details on file."}
{"id": "hard-interview-informal-hebrew", "kind": "interview", "expect": "interview", "hard": true, "from": {"name": "נועה", "address": "noa@kavim.example"}, "subject": "היי דנה", "body": "היי דנה, ראיתי את קורות החיים שלך למשרת מפתח/ת אוטומציה ונשמע מעניין. אפשר לדבר מחר ב-10:00 בטלפון? רוצה לשמוע קצת יותר על הניסיון שלך עם וואטסאפ.\n\nנועה, קווים דיגיטל"}
{"id": "hard-interview-calendar-invite", "kind": "interview", "expect": "interview", "hard": true, "from": {"name": "Relay Health Hiring", "address": "calendar@relayhealth.example"}, "subject": "Invitation: Dana Levi / Relay Health - technical conversation @ Tue 10 Nov 15:00", "body": "You have been invited to the following event.\n\nDana Levi / Relay Health - technical conversation\nWhen: Tuesday 10 November, 15:00 - 16:00\nWhere: Google Meet\nWho: Dana Levi, two engineers from the Implementation team\n\nPlease accept or propose another time."}
{"id": "hard-interview-reminder", "kind": "interview", "expect": "interview", "hard": true, "from": {"name": "Relay Health Hiring", "address": "hiring@relayhealth.example"}, "subject": "Reminder: tomorrow at 15:00", "body": "Hi Dana,\n\nA quick reminder that your technical conversation with our Implementation team is tomorrow at 15:00 on Google Meet. Please have a laptop ready to share your screen.\n\nSee you then."}
{"id": "hard-assessment-deadline-reminder", "kind": "assessment", "expect": "assessment", "hard": true, "from": {"name": "Tessera Careers", "address": "careers@tessera.example"}, "subject": "24 hours left", "body": "Dear Dana,\n\nYour coding test for the Integration Engineer application expires in 24 hours. If you have already submitted it, you can ignore this message.\n\nhttps://tests.example/t/abc"}
{"id": "hard-rejection-russian", "kind": "rejection", "expect": "rejection", "hard": true, "from": {"name": "Отдел кадров Klarwerk", "address": "hr@klarwerk.example"}, "subject": "Ваш отклик на вакансию", "body": "Здравствуйте, Дана!\n\nБлагодарим за интерес к вакансии Automation Developer. К сожалению, мы решили продолжить работу с другими кандидатами.\n\nЖелаем успехов в поиске."}
{"id": "hard-update-withdrawn", "kind": "update", "expect": "update", "hard": true, "from": {"name": "Northgate HR", "address": "hr@northgate.example"}, "subject": "Your application has been withdrawn", "body": "Hi Dana,\n\nAs you requested, we have withdrawn your application for Backend Developer, Integrations Team. You are welcome to apply again in the future."}
{"id": "hard-unrelated-company-newsletter", "kind": "not_related", "expect": "not_related", "hard": true, "from": {"name": "Halo Desk", "address": "news@halodesk.example"}, "subject": "What's new at Halo Desk: AI answers, new integrations", "body": "Hi Dana,\n\nThis month at Halo Desk: AI-suggested answers are now available to all customers, we added three new integrations, and our team is growing (see our open roles).\n\nRead the full product update on our blog."}
